{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "secure-bit",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
    "html_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
