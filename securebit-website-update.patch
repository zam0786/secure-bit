+                <div className="flex flex-wrap gap-2 mb-5">
+                  {post.tags.slice(0, 3).map((tag) => (
+                    <span
+                      key={tag}
+                      className="text-xs text-muted-foreground border border-border rounded-full px-2.5 py-1"
+                    >
