{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ltyrfowtfpccyokuraoi.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "securely-yours",
      "version": "0.1.0",
      "title": "Securely Yours"
    },
    "tools": [
      {
        "name": "list_contact_submissions",
        "title": "List contact submissions",
        "description": "List contact form submissions from the SecureBit website, newest first. Requires the signed-in user to be a security-team admin.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "How many submissions to return (default 10)."
            },
            "only_unhandled": {
              "type": "boolean",
              "description": "When true, return only submissions that have not been marked as handled."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_contact_submission",
        "title": "Get contact submission",
        "description": "Fetch the full details of a single contact form submission by its id. Requires the signed-in user to be a security-team admin.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "The submission id."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "mark_contact_submission_handled",
        "title": "Mark contact submission handled",
        "description": "Mark a contact form submission as handled (records the time the security team followed up). Requires the signed-in user to be a security-team admin.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "The submission id."
            },
            "handled": {
              "type": "boolean",
              "description": "Set false to clear the handled marker again. Defaults to true."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
